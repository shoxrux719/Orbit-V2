{
  "name": "orbit-local",
  "private": true,
  "type": "module",
  "scripts": {
    "design:build": "node design/build.cjs",
    "test": "node design/run-tests.cjs",
    "start": "node run-wrangler.cjs dev --local --config wrangler.local.json --ip 127.0.0.1 --port 3000",
    "db:migrate": "node run-wrangler.cjs d1 migrations apply DB --local --config wrangler.local.json",
    "school:setup": "node design/setup-admin.cjs",
    "build": "node deployment/build-vercel.cjs",
    "test:vercel": "npm run build && node design/run-tests.cjs deployment/vercel.test.mjs",
    "production:setup": "node deployment/setup-production.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.147.0",
    "esbuild": "0.28.1"
  },
  "dependencies": {
    "@libsql/client": "0.18.0"
  },
  "engines": {
    "node": "22.x"
  }
}
